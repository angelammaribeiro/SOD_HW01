-- Basic distance/heading stats for v1 (if you want)
SELECT
  MIN(distance_m) AS min_m,
  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY distance_m) AS p50_m,
  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY distance_m) AS p95_m,
  MAX(distance_m) AS max_m,
  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY heading_diff_deg) AS p50_heading_diff,
  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY heading_diff_deg) AS p95_heading_diff
FROM taxi_matched_topo;
